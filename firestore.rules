rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AISLAMIENTO MULTI-NEGOCIO
    //
    // Cada administrador (negocio) se identifica con su propio UID de
    // Firebase Auth. Ese UID es tambien el "negocioId": todos sus datos
    // viven en  negocios/{negocioId}/{coleccion}/{docId}.
    //
    //   Root    -> ve absolutely todo
    //   Admin   -> ve y edita SOLO su negocio (y solo si NO está bloqueado)
    //   Vendedor-> lee el catálogo de SU negocio y SOLO los documentos
    //             que le pertenecen (vendedorId == su UID)
    //
    // BLOQUEO EN CASCADA (Root -> Administrador):
    //   Cuando el Root bloquea a un administrador, ese administrador
    //   pierde TODO acceso a los datos de su negocio y sus vendedores
    //   quedan sin historial de ventas y sin poder modificar clientes.
    // ============================================================

    // ------------------------------------------------------------
    // Identidad
    // ------------------------------------------------------------

    // Superadministrador. Se reconoce por el claim "root" (asignado con
    // el Admin SDK) y, como respaldo, por su correo oficial.
    function esRoot() {
      return request.auth != null
        && (request.auth.token.root == true
            || request.auth.token.email == 'root@ventas.com');
    }

    // El usuario autenticado ES el administrador de este negocio.
    function esAdminDe(negocioId) {
      return request.auth != null && request.auth.uid == negocioId;
    }

    // El usuario autenticado es un vendedor registrado en este negocio.
    function esVendedorDe(negocioId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/negocios/$(negocioId)/vendedores/$(request.auth.uid));
    }

    // ------------------------------------------------------------
    // Estado del negocio
    // ------------------------------------------------------------

    // El negocio está SUSPENDIDO cuando el Root bloquea a su
    // administrador. La fuente de verdad es el perfil del administrador
    // (doc id = UID del admin = negocioId), campo "accesoActivo".
    function negocioSuspendido(negocioId) {
      return exists(/databases/$(database)/documents/admins/$(negocioId))
        && get(/databases/$(database)/documents/admins/$(negocioId)).data.get('accesoActivo', true) == false;
    }

    // El administrador solo opera mientras su negocio NO esté suspendido.
    // Un administrador bloqueado no puede ni leer ni escribir sus datos
    // (y tampoco puede auto-reactivarse: no puede escribir su perfil).
    function esAdminActivoDe(negocioId) {
      return esAdminDe(negocioId) && !negocioSuspendido(negocioId);
    }

    // ------------------------------------------------------------
    // Perfil del administrador (doc id = UID del admin = negocioId)
    // ------------------------------------------------------------
    match /admins/{adminUid} {
      // Lectura: siempre permitida para el propio admin (la app necesita
      // leer su perfil para mostrarle el aviso de "acceso suspendido").
      allow read: if esRoot() || (request.auth != null && request.auth.uid == adminUid);

      // Escritura: el admin solo puede editar su perfil mientras esté
      // activo. Si está bloqueado, únicamente el Root puede modificarlo
      // (así el admin no puede desbloquearse solo).
      allow write: if esRoot() || (esAdminActivoDe(adminUid));
    }

    // ------------------------------------------------------------
    // Espejo de perfiles de vendedores (doc id = UID de Auth).
    // Permite el login directo por UID y que Root liste el directorio.
    // ------------------------------------------------------------
    match /vendedores/{vendedorUid} {
      allow read: if esRoot()
        || (request.auth != null && request.auth.uid == vendedorUid)
        || esAdminActivoDe(resource.data.negocioId);

      allow create: if esRoot()
        || esAdminActivoDe(request.resource.data.negocioId);

      allow update: if esRoot()
        || esAdminActivoDe(resource.data.negocioId)
        || (request.auth != null && request.auth.uid == vendedorUid
            && request.resource.data.negocioId == resource.data.negocioId
            && request.resource.data.get('accesoActivo', true) == resource.data.get('accesoActivo', true));

      allow delete: if esRoot()
        || esAdminActivoDe(resource.data.negocioId);
    }

    // ------------------------------------------------------------
    // Ficha del vendedor DENTRO de su negocio.
    // El vendedor puede consultar y actualizar la SUYA propia
    // (y sólo si ya pertenece a ese negocio); el administrador
    // gestiona todas las de su negocio.
    // ------------------------------------------------------------
    match /negocios/{negocioId}/vendedores/{vendedorUid} {
      allow read: if esRoot()
        || esAdminActivoDe(negocioId)
        || (request.auth != null && request.auth.uid == vendedorUid && esVendedorDe(negocioId));

      allow create, update: if esRoot()
        || esAdminActivoDe(negocioId)
        || (request.auth != null && request.auth.uid == vendedorUid
            && esVendedorDe(negocioId)
            && request.resource.data.negocioId == resource.data.negocioId
            && request.resource.data.get('accesoActivo', true) == resource.data.get('accesoActivo', true));

      allow delete: if esRoot() || esAdminActivoDe(negocioId);
    }

    // ------------------------------------------------------------
    // Ficha del negocio (documento en negocios/{negocioId})
    // ------------------------------------------------------------
    match /negocios/{negocioId} {
      allow read: if esRoot() || esAdminActivoDe(negocioId) || esVendedorDe(negocioId);
      allow write: if esRoot() || esAdminActivoDe(negocioId);
    }

    // ------------------------------------------------------------
    // CATÁLOGO DEL NEGOCIO
    // Lo escribe el administrador; todos los vendedores de SU negocio
    // pueden leerlo, pero ninguno puede modificarlo.
    // Regla separada para no depender de `resource` en listados.
    // ------------------------------------------------------------
    match /negocios/{negocioId}/productos/{productoId} {
      allow read: if esRoot() || esAdminActivoDe(negocioId) || esVendedorDe(negocioId);
      allow write: if esRoot() || esAdminActivoDe(negocioId);
    }

    // ------------------------------------------------------------
    // RESTO DE DATOS DEL NEGOCIO
    // (clientes, ventas, nóminas, ...)
    //
    //   Lectura : Root y el admin ven todo su negocio.
    //             El vendedor ve SOLO los documentos que le pertenecen
    //             (vendedorId == su UID). Para listar, la consulta
    //             debe traer ese filtro; el servidor lo exige.
    //             Si el negocio está SUSPENDIDO el vendedor pierde
    //             además el HISTORIAL DE VENTAS.
    //   Escritura: El admin escribe todo su negocio.
    //             El vendedor sólo crea/actualiza documentos propios.
    //             Con el negocio suspendido NO puede escribir (no puede
    //             modificar clientes ni registrar ventas).
    //   Borrado : Sólo Root y el admin del negocio.
    // ------------------------------------------------------------
    match /negocios/{negocioId}/{coleccion}/{docId} {
      allow read: if esRoot()
        || esAdminActivoDe(negocioId)
        || (esVendedorDe(negocioId)
            && resource.data.vendedorId == request.auth.uid
            && (coleccion != 'ventas' || !negocioSuspendido(negocioId)));

      allow create: if esRoot()
        || esAdminActivoDe(negocioId)
        || (esVendedorDe(negocioId)
            && request.resource.data.vendedorId == request.auth.uid
            && !negocioSuspendido(negocioId));

      allow update: if esRoot()
        || esAdminActivoDe(negocioId)
        || (esVendedorDe(negocioId)
            && resource.data.vendedorId == request.auth.uid
            && request.resource.data.vendedorId == request.auth.uid
            && !negocioSuspendido(negocioId));

      allow delete: if esRoot() || esAdminActivoDe(negocioId);
    }

    // ------------------------------------------------------------
    // Todo lo demás queda DENEGADO
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
